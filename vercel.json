{
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/*.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.mymemory.translated.net https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?type=home"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?type=post&slug=:slug"
    },
    {
      "source": "/du-an/:slug",
      "destination": "/api/page?type=project&slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/page?type=static&page=blog"
    },
    {
      "source": "/cv",
      "destination": "/api/page?type=static&page=cv"
    },
    {
      "source": "/kiem-thu",
      "destination": "/api/page?type=static&page=kiem-thu"
    },
    {
      "source": "/bug/:slug",
      "destination": "/api/page?type=bug&slug=:slug"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/rss-en.xml",
      "destination": "/api/rss?lang=en"
    },
    {
      "source": "/index.html",
      "destination": "/api/page?type=home"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/api/page?type=notfound"
    }
  ]
}
