{
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/*.html"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?type=home"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?type=post&slug=:slug"
    },
    {
      "source": "/du-an/:slug",
      "destination": "/api/page?type=project&slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/page?type=static"
    },
    {
      "source": "/cv",
      "destination": "/api/page?type=static"
    },
    {
      "source": "/kiem-thu",
      "destination": "/api/page?type=static"
    },
    {
      "source": "/bug/:slug",
      "destination": "/api/page?type=bug&slug=:slug"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/rss-en.xml",
      "destination": "/api/rss?lang=en"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/app.html"
    }
  ]
}
