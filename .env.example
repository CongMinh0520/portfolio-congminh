# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...   # khóa "anon / public", KHÔNG dùng service_role

# Cloudflare → Turnstile → Site Key (ô chống spam ở form Liên hệ; để trống = form chưa gửi được thật)
VITE_TURNSTILE_SITE_KEY=

# Thông báo đẩy (không bắt buộc): khóa công khai VAPID, tạo ở Admin → Cài đặt → Thông báo → Thông báo đẩy → nút "?"
VITE_VAPID_PUBLIC_KEY=
